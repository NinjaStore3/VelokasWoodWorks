{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velokas-woodworks",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // The web app lives in ./public. Only /api/* requests reach the Worker;
  // everything else is served straight from Cloudflare's static asset cache.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // No database_id needed: `wrangler deploy` creates "velokas-db" on the first
  // deploy (or links it if it already exists).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "velokas-db",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
